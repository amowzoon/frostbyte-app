<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Configuration
  Docs: https://developer.android.com/training/articles/security-config

  Policy:
  - Production (ngrok HTTPS domain): encrypted by default, no config needed.
  - Local dev only: HTTP allowed to 10.0.0.x (LAN) and 10.0.2.2 (Android
    emulator host alias). These domains are NEVER reachable from the internet
    so allowing cleartext here carries no real-world risk.
  - All other traffic: HTTPS required, cleartext blocked.

  This file is referenced from AndroidManifest.xml via:
    android:networkSecurityConfig="@xml/network_security_config"
-->
<network-security-config>

  <!-- Local development: allow HTTP to LAN and emulator host only -->
  <domain-config cleartextTrafficPermitted="true">
    <!-- Android emulator accesses host machine at 10.0.2.2 -->
    <domain includeSubdomains="false">10.0.2.2</domain>
    <!-- LAN IP of Hudson's Linux machine (dev only) -->
    <domain includeSubdomains="false">10.0.0.18</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>

  <!-- Everything else: HTTPS only, no cleartext -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <!-- Trust system CA store (covers ngrok's Let's Encrypt cert) -->
      <certificates src="system"/>
    </trust-anchors>
  </base-config>

</network-security-config>